#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
# pre-commit hook — runs custom_agent's static scan on staged changes.
# Installed automatically by custom_agent/setup.sh (or copy manually):
#   cp custom_agent/git_integration/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Exit 0 → commit proceeds (PASS or WARN)
# Exit 1 → commit BLOCKED (CRITICAL findings found)
#
# Bypass in an emergency:  SKIP_AGENT=1 git commit -m "..."
# ──────────────────────────────────────────────────────────────────────────────

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
AGENT_DIR="$REPO_ROOT/custom_agent"
PYTHON="${PYTHON:-python3}"

if [ "${SKIP_AGENT:-0}" = "1" ]; then
    echo "[custom-agent] SKIP_AGENT=1 set — skipping pre-commit scan"
    exit 0
fi

if [ ! -f "$AGENT_DIR/main.py" ]; then
    echo "[custom-agent] custom_agent/main.py not found — skipping scan"
    exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
CHANGED=$(echo "$STAGED" | grep -E "\.(sql|py)$" || true)

if [ -z "$CHANGED" ]; then
    echo "[custom-agent] No staged .sql/.py changes — skipping scan"
    exit 0
fi

echo ""
echo "┌─────────────────────────────────────────────────────┐"
echo "│  custom_agent — Pre-Commit Complexity & Security Scan│"
echo "└─────────────────────────────────────────────────────┘"

cd "$REPO_ROOT"
set +e
"$PYTHON" "$AGENT_DIR/main.py" --mode static --ci \
    --output ".agent_pre_commit_report.md"
EXIT_CODE=$?
set -e

if [ $EXIT_CODE -eq 1 ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════╗"
    echo "║  ❌  COMMIT BLOCKED — CRITICAL findings              ║"
    echo "║  Fix them, or bypass: SKIP_AGENT=1 git commit ...    ║"
    echo "║  Full report: .agent_pre_commit_report.md            ║"
    echo "╚══════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

echo ""
echo "✅  Pre-commit scan passed — no CRITICAL findings."
echo ""
exit 0
